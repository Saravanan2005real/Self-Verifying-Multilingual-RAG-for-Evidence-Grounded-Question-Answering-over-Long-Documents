# DocQuery AI - Environment Variables

# Google Gemini API Key (Required for embeddings & response generation)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB Server URL (Optional, defaults to http://localhost:8000)
CHROMA_URL=http://localhost:8000

# Backend Port (Optional, defaults to 8080)
SERVER_PORT=8080
